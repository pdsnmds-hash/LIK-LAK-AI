<resources>
 <color name="brand_graphite">#0B1012</color>
 <item name="ic_launcher_round" type="mipmap">@mipmap/ic_launcher</item>
 <style name="LaunchTheme" parent="Theme.SplashScreen">
  <item name="windowSplashScreenBackground">@color/brand_graphite</item>
  <item name="windowSplashScreenAnimatedIcon">@drawable/brand_icon_foreground</item>
  <item name="postSplashScreenTheme">@style/AppTheme</item>
  <item name="android:windowBackground">@drawable/launch_background</item>
  <item name="android:windowLightStatusBar">false</item>
  <item name="android:statusBarColor">@color/brand_graphite</item>
  <item name="android:navigationBarColor">@color/brand_graphite</item>
 </style>
</resources>
